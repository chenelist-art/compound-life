{
 "about": "The people in your life: cards about your brothers and sisters, children, parents, best friend and boss. \"who\" picks the person a card is about (their name and role come from js/people.js); an option's \"bond\" changes how close you are.",
 "events": [
  {
   "id": "sib_wed",
   "when": {"age": [16, 95]},
   "who": {"role": "sib", "test": "p.eng"},
   "def": "usual",
   "tarot": "fwed",
   "art": "fwed",
   "let": {"a": ".05 * base"},
   "fn": {
    "gift": {
     "args": ["x"],
     "do": "pay(x); const t = T('sibwed', {kind: 'ghost', label: M('trk.sibWed', {p: name(p)})}); t.spent += x; t.g += x"
    },
    "wedded": {"args": [], "do": "p.eng = false; p.wed = true"}
   },
   "vars": {"p": "Who(p)"},
   "opts": [
    {
     "id": "big",
     "sub": {"a": "MN(3 * a)"},
     "rel": 1,
     "bond": 12,
     "do": "wedded(); gift(3 * a); happy += 2"
    },
    {"id": "usual", "sub": {"a": "MN(a)"}, "bond": 6, "do": "wedded(); gift(a)"},
    {"id": "skip", "bond": -10, "do": "wedded()"}
   ],
   "i18n": {
    "en": {
     ".t": "A wedding in the family",
     ".x": "{p} is getting married. Everyone expects a gift, and you're asked to help with the day.",
     ".big": "Give a generous gift and help pay for the day",
     ".big.s": "{a}. Happiness +2.",
     ".usual": "Give the usual gift",
     ".usual.s": "{a}.",
     ".skip": "Send your best wishes",
     ".skip.s": "Free, but it's noticed.",
     "trk.sibWed": "{p}'s wedding"
    },
    "zh": {
     ".t": "家里的喜事",
     ".x": "{p}要结婚了。大家都等着送礼，你也被请去帮忙张罗。",
     ".big": "包个大礼，还帮忙出婚礼的钱",
     ".big.s": "{a}。幸福感 +2。",
     ".usual": "照惯例送礼",
     ".usual.s": "{a}。",
     ".skip": "送上祝福就好",
     ".skip.s": "不花钱，但大家都看在眼里。",
     "trk.sibWed": "{p}的婚礼"
    },
    "zht": {
     ".t": "家裡的喜事",
     ".x": "{p}要結婚了。大家都等著送禮，你也被請去幫忙張羅。",
     ".big": "包個大禮，還幫忙出婚禮的錢",
     ".big.s": "{a}。幸福感 +2。",
     ".usual": "照慣例送禮",
     ".usual.s": "{a}。",
     ".skip": "送上祝福就好",
     ".skip.s": "不花錢，但大家都看在眼裡。",
     "trk.sibWed": "{p}的婚禮"
    }
   }
  },
  {
   "id": "kid_uni",
   "who": {"role": "kid", "age": [18, 19], "test": "!p.uni"},
   "def": "pay",
   "tarot": "edufund",
   "art": "edu",
   "let": {"f": "kidFee()", "fund": "lots.kidedu ? lots.kidedu.v : 0"},
   "fn": {
    "fees": {
     "args": ["share"],
     "do": "let need = f * share; const l = lots.kidedu; if (l && l.v > 0) { const x = Math.min(l.v, need); l.v -= x; l.tout += x; need -= x } if (need > 0) pay(need); const t = T('uni_' + p.id, {kind: 'custom', label: M('trk.kidUni', {p: name(p)})}); t.v -= need; t.note = M('note.paid', {a: MN(-t.v)})"
    },
    "mark": {"args": [], "do": "p.uni = true; if (!kidUni) kidUni = {}; kidUni[p.b] = 1"}
   },
   "vars": {"p": "Who(p)", "a": "MN(f)", "x": "fund > 1 ? M('.fund', {a: MN(Math.min(fund, f))}) : ''"},
   "again": "delete done.kid_uni",
   "opts": [
    {"id": "pay", "sub": {"a": "MN(f)"}, "bond": 8, "do": "mark(); fees(1); happy += 2"},
    {"id": "half", "sub": {"a": "MN(f / 2)"}, "bond": 3, "do": "mark(); fees(.5)"},
    {"id": "loan", "bond": -5, "do": "mark(); happy -= 2"}
   ],
   "i18n": {
    "en": {
     ".t": "Off to university",
     ".x": "{p} got into university. The fees come to about {a}.{x}",
     ".fund": " Your education fund can cover {a}.",
     ".pay": "Pay the fees",
     ".pay.s": "{a}, from the education fund first. Happiness +2.",
     ".half": "Pay half; they borrow the rest",
     ".half.s": "{a}.",
     ".loan": "Let them take student loans",
     ".loan.s": "Costs you nothing. They start adult life in debt. Happiness −2.",
     "trk.kidUni": "{p}'s university fees"
    },
    "zh": {
     ".t": "上大学了",
     ".x": "{p}考上了大学，学费大约要{a}。{x}",
     ".fund": "教育基金可以支付{a}。",
     ".pay": "付全部学费",
     ".pay.s": "{a}，先从教育基金扣。幸福感 +2。",
     ".half": "付一半，剩下的让孩子贷款",
     ".half.s": "{a}。",
     ".loan": "让孩子申请助学贷款",
     ".loan.s": "你不用花钱，孩子一踏入社会就背着债。幸福感 −2。",
     "trk.kidUni": "{p}的大学学费"
    },
    "zht": {
     ".t": "上大學了",
     ".x": "{p}考上了大學，學費大約要{a}。{x}",
     ".fund": "教育基金可以支付{a}。",
     ".pay": "付全部學費",
     ".pay.s": "{a}，先從教育基金扣。幸福感 +2。",
     ".half": "付一半，剩下的讓孩子貸款",
     ".half.s": "{a}。",
     ".loan": "讓孩子申請就學貸款",
     ".loan.s": "你不用花錢，孩子一踏入社會就背著債。幸福感 −2。",
     "trk.kidUni": "{p}的大學學費"
    }
   }
  },
  {
