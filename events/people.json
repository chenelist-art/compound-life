  {
   "id": "par_funeral",
   "when": {"age": [18, 95]},
   "who": {"role": "parent", "dead": true, "test": "p.dead === age - 1 && !p.fun"},
   "def": "simple",
   "tarot": "funeral",
   "art": "funeral",
   "let": {"a": ".25 * base", "b": ".08 * base", "n": "people('sib').length"},
   "fn": {
    "bury": {
     "args": ["x"],
     "do": "p.fun = true; pay(x); const t = T('fun_' + p.id, {kind: 'ghost', label: M('trk.funeralP', {p: name(p)})}); t.spent += x; t.g += x"
    }
   },
   "vars": {"p": "Who(p)"},
   "again": "delete done.par_funeral",
   "opts": [
    {"id": "full", "sub": {"a": "MN(a)"}, "rel": 2, "do": "bury(a); happy += 1"},
    {"id": "simple", "sub": {"a": "MN(b)"}, "do": "bury(b)"},
    {
     "id": "share",
     "show": "n > 0",
     "sub": {"a": "MN(a / (n + 1))"},
     "do": "bury(a / (n + 1)); bond('sib', 3)"
    }
   ],
   "i18n": {
    "en": {
     ".t": "Saying goodbye",
     ".x": "{p} passed away last year. The family is planning the funeral.",
     ".full": "A full funeral, with everyone invited",
     ".full.s": "{a}. Happiness +1.",
     ".simple": "A simple, quiet funeral",
     ".simple.s": "{a}.",
     ".share": "A full funeral, sharing the costs with your siblings",
     ".share.s": "Your part: about {a}.",
     "trk.funeralP": "Funeral for {p}"
    },
    "zh": {
     ".t": "送别",
     ".x": "{p}去年离开了。家里正在准备葬礼。",
     ".full": "办一场隆重的葬礼，请大家都来",
     ".full.s": "{a}。幸福感 +1。",
     ".simple": "简单安静地办",
     ".simple.s": "{a}。",
     ".share": "办隆重的葬礼，跟兄弟姐妹分摊费用",
     ".share.s": "你出大约{a}。",
     "trk.funeralP": "{p}的葬礼"
    },
    "zht": {
     ".t": "送別",
     ".x": "{p}去年離開了。家裡正在準備喪禮。",
     ".full": "辦一場隆重的喪禮，請大家都來",
     ".full.s": "{a}。幸福感 +1。",
     ".simple": "簡單安靜地辦",
     ".simple.s": "{a}。",
     ".share": "辦隆重的喪禮，跟兄弟姊妹分攤費用",
     ".share.s": "你出大約{a}。",
     "trk.funeralP": "{p}的喪禮"
    }
   }
  },
